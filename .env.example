# Root environment for `docker compose`. Copy to `.env` and fill in as needed.
# `docker compose` reads `.env` automatically; every value below also has a safe in-file
# default, so `docker compose up` works with NO .env at all.

# --- Parallel isolated instances (docs/design.md §6). Override per instance. ---------------
# Distinct compose project name → isolated container/network/image namespaces.
COMPOSE_PROJECT_NAME=newsroom
# Host ports (internal ports are fixed; only these host mappings change per instance). WEB_PORT
# is the HTTPS port `docker-compose.override.yml`'s `edge` (Caddy) service publishes — `web`
# itself is not published (docs/local-dev.md "Local HTTPS"). 443 is the default so the app is
# reachable at plain `https://localhost` with no port, matching the redirect URI already
# registered on the Google OAuth client (docs/auth.md) — changing WEB_PORT without also changing
# AUTH_URL below to match breaks Google sign-in (scripts/instance.sh does this automatically for
# isolated instances, which never use 443).
WEB_PORT=443
AGENTS_PORT=8000
MONGO_PORT=27017

# --- Service config ------------------------------------------------------------------------
ENVIRONMENT=development

# --- Provider keys — SERVER-SIDE ONLY, never client-exposed (§6, D14). Do NOT commit real keys. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LLM backend (agents/app/config.py): bedrock (default) | openai | openrouter | anthropic. ---
# "openrouter" runs inference through OpenRouter's OpenAI-compatible endpoint: set
# OPENAI_API_KEY to an OpenRouter key. OPENAI_BASE_URL is optional — for "openrouter" it
# defaults to https://openrouter.ai/api/v1, for "openai" to the openai SDK default
# (api.openai.com). OPENROUTER_DEFAULT_MODEL_ID selects the step-tier model on OpenRouter
# (default z-ai/glm-5, the same GLM-5 tier as the bedrock backend, under OpenRouter's slug).
LLM_BACKEND=bedrock
OPENAI_BASE_URL=
OPENROUTER_DEFAULT_MODEL_ID=z-ai/glm-5
# Default reasoning effort for the openai/openrouter provider (blank = send nothing, the old
# behavior). Set "low" when the selected model is mandatory-reasoning over OpenRouter (e.g.
# z-ai/glm-5.3-flash): reasoning there cannot be disabled, so without this hint the model can
# spend a step's whole max_tokens budget on reasoning and return empty content (seen live as
# blank interview questions). Per-call explicit effort always overrides this default.
OPENAI_REASONING_EFFORT=

# --- Google Docs/Drive OAuth grant for agents/ (agents/app/config.py) — SEPARATE from web/'s own
# Google sign-in grant below. Enables review-doc mint/share, finalize Google Doc export, and
# Drive folder writes (agents/app/render, agents/app/review, agents/app/drive). Left blank,
# those features fail cleanly inside their own job/route rather than crashing boot.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Slack connector bot token (agents/app/connectors/slack.py). Slack ingestion is otherwise
# unwired end-to-end (tracked separately) — this only forwards the token locally.
SLACK_BOT_TOKEN=

# Publish (agents/app/publish/) — public-read S3 bucket name published HTML/PDF renders upload to.
# Left blank, POST /api/pieces/{id}/publish 503s cleanly.
PUBLISHED_ASSETS_BUCKET=

# Named root folder for per-piece Google Drive artifacts (agents/app/drive/) — the app creates/
# finds it in its own My Drive under the drive.file scope (not a secret, not a Shared Drive).
# Blank (default): review/finalize/publish artifacts are never uploaded to a Drive folder.
GOOGLE_DRIVE_ROOT_FOLDER_NAME=

# --- Auth for web/ (§6, docs/auth.md). Server-side only. -----------------------------------
# Google Workspace OAuth, restricted to AUTH_ALLOWED_EMAIL_DOMAIN. Leave BOTH blank to keep the
# local-dev identity-declaration fallback (anyone signs in by declaring an email, no OAuth) —
# filling in real values (never commit them) switches /signin to Google-only. Redirect URI for
# `docker compose up` at the default WEB_PORT: https://localhost/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domain a signed-in Google account's verified email must match. Only enforced when the two vars
# above are both set.
AUTH_ALLOWED_EMAIL_DOMAIN=

# Session-cookie signing secret. Optional: web/auth.ts falls back to a fixed POC value when
# unset, so the stack boots with no auth setup at all — orthogonal to which provider is active.
NEXTAUTH_SECRET=

# Public base URL NextAuth builds OAuth callback/redirect URLs from. This is NOT optional
# decoration once Google is configured: leaving it unset lets NextAuth infer the URL from the
# incoming request, and on a bare Next.js standalone server that inference can silently resolve to
# the container's own bind address (0.0.0.0) instead of the real host, even though the request's
# actual `Host` header is correct — Google then refuses the mismatched redirect_uri at the
# token-exchange step, well after the sign-in button appeared to work (observed during a
# diagnosis of a token-exchange host mismatch). Leave blank for local dev at the default WEB_PORT
# (443) — docker-compose.override.yml then defaults this to `https://localhost` (no port,
# matching both 443 and the registered redirect URI exactly). If you override WEB_PORT, you MUST
# set this to `https://localhost:$WEB_PORT` to match, or you'll reintroduce the exact
# host-mismatch bug this var exists to prevent (scripts/instance.sh does this automatically for
# isolated instances). Real deployments must set this to their actual public URL
# (e.g. `https://example.com`).
AUTH_URL=

# --- Git brain (HendoCode/content-machine-brain), bind-mounted into the agents container ---------
# Where the brain clone lives on the HOST (bind-mounted to /brain in the container — see
# docker-compose.yml, newsroom-agent/README.md). Defaults to a sibling of this repo.
BRAIN_HOST_PATH=../content-machine-brain
# Set these to have the container clone the brain itself on first boot if BRAIN_HOST_PATH is
# empty (e.g. you haven't cloned it by hand yet). Leave both blank if you already keep a clone at
# BRAIN_HOST_PATH yourself — the container then just uses it directly, no credentials needed.
BRAIN_REPO_URL=
# Optional SSH deploy-key PRIVATE key (repo-scoped, read-write) for an authenticated clone/pull/
# push — only needed when no ambient SSH credential is available for BRAIN_REPO_URL. See
# infra/aws-poc/README.md "Brain push credential" for generate/install/store steps. Resolved
# through the secrets shim below in real deployments; never commit a real value here.
BRAIN_DEPLOY_KEY=

# --- Secrets shim (agents/app/secrets/README.md; web/lib/secrets/) — how every secret above is ---
# actually resolved. Leave at "env" for local dev: values above are then read as plain env vars,
# unchanged from before this shim existed. "aws"/"azure" are the production alternatives.
SECRETS_BACKEND=env
SECRETS_CACHE_TTL_SECONDS=300
# Only used when SECRETS_BACKEND=aws: SSM Parameter Store path prefix.
SECRETS_AWS_SSM_PREFIX=/newsroom/
# Only used when SECRETS_BACKEND=azure: the Key Vault URL.
SECRETS_AZURE_VAULT_URL=

# --- Edge reverse proxy — docker-compose.prod.yml ONLY (docs/deploy.md), unused by the base
# file/local dev.
EDGE_PORT=80
