# agents/ service environment. Copy to `.env` for local (non-Docker) runs; docker-compose
# injects these for the container. Keys are SERVER-SIDE ONLY and never client-exposed (§6, D14).
ENVIRONMENT=development

# --- Secrets shim (app/secrets/README.md). Selects how the secrets below are actually resolved.
# Leave unset/"env" for local dev — every value below is then just read from this file / the
# process environment, unchanged from before this shim existed.
SECRETS_BACKEND=env
SECRETS_CACHE_TTL_SECONDS=300
# Only used when SECRETS_BACKEND=aws: SSM Parameter Store path prefix.
SECRETS_AWS_SSM_PREFIX=/newsroom/
# Only used when SECRETS_BACKEND=azure: the Key Vault URL.
SECRETS_AZURE_VAULT_URL=

# --- Provider keys (placeholders — do NOT commit real keys). Downstream tickets use these. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LLM backend selection (app/config.py): bedrock (default) | openai | openrouter | anthropic.
# "openrouter" is first-class: the OpenAI-compatible provider pointed at OpenRouter — set
# OPENAI_API_KEY to an OpenRouter key; OPENAI_BASE_URL is optional and defaults to
# https://openrouter.ai/api/v1 for this backend (for "openai" the openai SDK's own default /
# native OPENAI_BASE_URL read applies, unchanged). OPENROUTER_DEFAULT_MODEL_ID is the step-tier
# model on OpenRouter (default z-ai/glm-5 — the same GLM-5 tier, under OpenRouter's slug).
LLM_BACKEND=bedrock
OPENAI_BASE_URL=
OPENROUTER_DEFAULT_MODEL_ID=z-ai/glm-5

# --- Green-connector credentials (server-side only; NEVER in a Source registry doc, D8/D14). ---
# An admin provisions these; leave blank in dev (connectors then report an auth error per source
# on refresh — they never crash the service). See app/connectors/README.md for provisioning steps.
#
# Google Drive: recommended server-side incremental OAuth on the SSO (Google) identity. Provision
# a Google Cloud OAuth client with BOTH the drive.readonly (connector reads) and drive.file
# (finalize/review Google Docs export writes — app/render, app/review) scopes, and complete a
# one-time offline consent to obtain a refresh token; store the three values below. (A
# folder-scoped service account is the documented fallback.)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Named root folder (in the app's own My Drive) that scopes every per-piece Google Drive artifact
# (agents/app/drive/README.md). NOT a secret. The app creates/finds it itself under the drive.file
# scope; blank = no folder (Docs land loose at the Drive root, no HTML/PDF Drive upload).
GOOGLE_DRIVE_ROOT_FOLDER_NAME=
# Slack: create a Slack app, add bot scopes channels:history, channels:read, groups:history,
# install it to the workspace, and paste the bot token (xoxb-…). Web/RSS needs no credential.
SLACK_BOT_TOKEN=

# --- Datastore. Single MongoDB (Atlas in prod; compose `mongo` locally) for work-state (D3). ---
# The compose file already injects a URL for the container; set this for non-Docker local runs.
MONGO_URL=
# Logical db name inside that instance (the compose URL carries `content_machine`; this is the
# fallback used when the connection string names no default database).
MONGO_DB_NAME=content_machine

# --- Content lake / hybrid index (D9). Same Mongo instance backs the lake (§7). ---
# Query backend: `local` (default) runs against plain `mongo:7`; `atlas` pushes down to Atlas
# Vector Search + Atlas Search in production. See app/lake/README.md — flip is a config change.
LAKE_INDEX_BACKEND=local
# Embedding provider for the semantic leg: `hashing` (default, no key/network) or a real provider.
EMBEDDING_BACKEND=hashing
# Embedding vector width; must match the Atlas vector-index definition in production.
EMBEDDING_DIM=256

# --- Git brain / content store (D2/D4). The brain is its own repo, HendoCode/content-machine-brain,
# cloned read-write onto disk (never baked into this repo as a subdirectory). ---
# Filesystem root of the local brain clone (voices/personas/engine/piece folders). For a non-Docker
# run, this is relative to the agents/ process's own working directory; the default assumes a
# sibling checkout of content-machine-brain (see newsroom-agent/README.md's re-point
# instructions) — set an absolute path if your clone lives elsewhere. docker-compose overrides
# this to the fixed in-container bind-mount path (/brain); see the root .env.example instead.
BRAIN_ROOT=../content-machine-brain
# Git remote to clone BRAIN_ROOT from if it doesn't exist yet, and to fast-forward-pull from on
# every boot after that (picks up hand-nurtured brain updates). An SSH URL, e.g.
# git@github.com:HendoCode/content-machine-brain.git. Leave blank for local dev where BRAIN_ROOT
# already points at a clone you manage yourself with your own git.
BRAIN_REPO_URL=
# Optional SSH deploy-key PRIVATE key (repo-scoped, read-write — least-privilege machine push,
# see infra/aws-poc/README.md "Brain push credential" for generate/install/store steps) for
# clone/pull/push against BRAIN_REPO_URL, for when no ambient SSH credential is available (e.g. a
# container). Resolved through the secrets shim above (like ANTHROPIC_API_KEY/MONGO_URL) — never
# commit a real value here.
BRAIN_DEPLOY_KEY=
# Default identity stamped on machine-authored commits (a real acting user is passed per-commit).
GIT_AUTHOR_NAME=newsroom-agent
GIT_AUTHOR_EMAIL=agent@newsroom.local

# Build/test brain pin (agents/brain.lock, agents/app/git/README.md). Leave blank for a normal
# dev/prod boot — the app then tracks the live branch exactly as above (clone once, pull on every
# later boot). Set only when constructing/testing against the known-good pinned commit instead of
# "whatever main currently is": a commit SHA/tag pins the clone there (detached HEAD) instead of
# pulling. Never set this in docker-compose.yml's runtime `agents` service.
BRAIN_REF=
