# web/ service environment. Copy to `.env.local` for local (non-Docker) runs; docker-compose
# injects these for the container.

# Server-side URL of the Python agents service. NOT prefixed NEXT_PUBLIC_ → never sent to the
# browser (docs/design.md §6). In docker compose this is set to the internal service address.
AGENTS_URL=http://localhost:8000

# --- Auth (design.md §6, docs/auth.md). ALL server-side only — never NEXT_PUBLIC_. -------------

# Google Workspace OAuth, restricted to AUTH_ALLOWED_EMAIL_DOMAIN. Leave BOTH blank to keep the
# local-dev identity-declaration fallback (anyone signs in by declaring an email, no OAuth) —
# filling in real values (never commit them) switches /signin to Google-only. Redirect URI for
# this file's own use — `npm run dev`, plain HTTP, not the Docker/HTTPS stack (docs/local-dev.md):
# http://localhost:3000/api/auth/callback/google. Running the full stack via `docker compose up`
# instead reads the root `.env`, not this file, and is HTTPS-only — see the root `.env.example`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domain a signed-in Google account's verified email must match. Only enforced when the two vars
# above are both set.
AUTH_ALLOWED_EMAIL_DOMAIN=

# Session-cookie signing secret. Optional: `web/auth.ts` falls back to a fixed POC value when
# unset (there is nothing real to protect — sign-in is a self-declared identity, not a password).
# Generate with `openssl rand -base64 32` if you want a real one anyway.
NEXTAUTH_SECRET=

# --- Secrets shim (lib/secrets/) — how NEXTAUTH_SECRET (and any future secret read here) is ---
# actually resolved. Leave at "env" for local dev: it's then read as a plain env var above,
# unchanged from before this shim existed. Shares the same config convention + backend names as
# agents/app/secrets/ (Python) — see that package's README.md.
SECRETS_BACKEND=env
SECRETS_CACHE_TTL_SECONDS=300
# Only used when SECRETS_BACKEND=aws: SSM Parameter Store path prefix.
SECRETS_AWS_SSM_PREFIX=/newsroom/
# Only used when SECRETS_BACKEND=azure: the Key Vault URL.
SECRETS_AZURE_VAULT_URL=
